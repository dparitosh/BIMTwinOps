# =============================================================================
# BIMTwinOps — Centralized Backend Configuration
# =============================================================================
# Copy this file to .env and fill in required values.
# NEVER commit .env — it is in .gitignore.
# All configuration is centralized here — no hardcoding in source files.
# =============================================================================

# ── Backend Server ──
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8008

# ── CORS (comma-separated origins) ──
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Neo4j (required for Knowledge Graph features) ──
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<your-neo4j-password>
NEO4J_DATABASE=bimtwin

# ── Google Gemini / GenAI (optional — for /chat endpoint) ──
GOOGLE_API_KEY=<your-google-api-key>
LLM_PROVIDER=ollama

# ── Ollama (Local LLM — required for agent features) ──
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_EMBED_MODEL=nomic-embed-text:latest

# ── Azure OpenAI (optional — alternative LLM provider) ──
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ── APS (Autodesk Platform Services — optional for 3D viewer) ──
APS_CLIENT_ID=<your-aps-client-id>
APS_CLIENT_SECRET=<your-aps-client-secret>
APS_SERVICE_PORT=3001
APS_CALLBACK_URL=http://127.0.0.1:3001/aps/oauth/callback
APS_SCOPES=viewables:read
APS_OAUTH_SCOPES=data:read data:write data:create bucket:create bucket:read viewables:read
APS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001
APS_BUCKET_KEY=smartbim-demo-bucket
APS_OSS_REGION=US
APS_STORE=memory
APS_SESSION_TTL_SECONDS=86400

# ── BaseX (XML Database — optional) ──
BASEX_HOST=localhost
BASEX_PORT=1984
BASEX_USER=admin
BASEX_PASSWORD=<your-basex-password>
BASEX_DB_NAME=bsdd_documents

# ── OpenSearch (Vector Memory — optional) ──
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=

# ── Redis (session store — optional) ──
REDIS_URL=

# ── Frontend ──
FRONTEND_PORT=5173
FRONTEND_MODE=proxy
FRONTEND_DEV_URL=http://localhost:5173
