# =============================================================================
# BIMTwinOps Frontend — Environment Variables
# Copy to .env.local and fill in values for your environment.
# In LOCAL DEV mode (npm run dev), leave these blank — Vite proxy handles routing.
# In PRODUCTION or a SEPARATE/REMOTE environment, set them explicitly.
# =============================================================================

# APS service URL (Autodesk Platform Services)
# LOCAL DEV:  leave blank (Vite proxies /aps/* -> port 3001)
# PRODUCTION: set to wherever the APS service is running, e.g. http://your-server:3001
VITE_APS_API_URL=

# Backend API URL (FastAPI)
# LOCAL DEV:  leave blank (Vite proxies /api/*, /health, /upload -> port 8008)
# PRODUCTION: set to wherever the backend is running, e.g. http://your-server:8008
VITE_BACKEND_API_URL=

# Frontend port (default: 5173)
VITE_FRONTEND_PORT=5173
