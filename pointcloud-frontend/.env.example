# =============================================================================
# BIMTwinOps Frontend — Vite environment variables
# =============================================================================
# Copy this file to .env and modify as needed.
# Vite env vars must start with VITE_ to be exposed to the browser.
# Restart the Vite dev server after changing VITE_* values.
# =============================================================================

# Backend FastAPI URL
VITE_BACKEND_API_URL=http://127.0.0.1:8000

# APS Service URL
VITE_APS_API_URL=http://127.0.0.1:3001

# Ollama LLM URL (for health-check display in dashboard)
VITE_OLLAMA_URL=http://localhost:11434

# Neo4j URI (for health-check display in dashboard)
VITE_NEO4J_URI=bolt://localhost:7687

# Frontend dev-server port
VITE_FRONTEND_PORT=5173
